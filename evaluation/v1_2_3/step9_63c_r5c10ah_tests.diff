+            self.assertIn("RT4", failed(builder.plan_retirement(root)))
+
+    def test_rt5_the_determination_must_exist_equal_its_canonical_bytes_and_reference_the_approval(self):
+        cases = {"missing": lambda r: (r / builder.DETERMINATION_PATH).unlink(),
+                 "edited": lambda r: (r / builder.DETERMINATION_PATH).write_bytes((r / builder.DETERMINATION_PATH).read_bytes() + b" "),
+                 "other approval id": lambda r: (r / builder.DETERMINATION_PATH).write_bytes(builder.canonical_determination_bytes("approval-step9_63c_r11-" + "0" * 32)),
+                 "symlink": lambda r: (os.remove(r / builder.DETERMINATION_PATH), os.symlink(r / "scripts", r / builder.DETERMINATION_PATH))}
+        for label, change in cases.items():
+            with self.subTest(case=label):
