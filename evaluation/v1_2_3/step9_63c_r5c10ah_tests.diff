+    def test_rt6_historical_pin_tampering_blocks(self):
+        root = T.clone("s0")
+        pinned = root / "evaluation/v1_2_3/step9_61a_v3_runner_freeze_r6.json"
+        pinned.write_bytes(pinned.read_bytes() + b" ")
