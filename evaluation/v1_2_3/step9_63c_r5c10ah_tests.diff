+
+    def test_rt7_synthetic_root_needs_the_switch(self):
+        root = T.clone("s0")
+        with patch.dict(os.environ):
+            os.environ.pop(builder.SYNTHETIC_ROOT_ENV, None)
+            self.assertIn("RT7", failed(builder.plan_retirement(root)))
+
+    def test_read_only_modes_never_write(self):
+        for flag in ("--plan-retire", "--verify-retire"):
+            with self.subTest(flag=flag):
+                root = T.clone("s0")
+                before = fx.tree_digest(root)
+                code, output = g.cli(root, flag, mode="pipe")
