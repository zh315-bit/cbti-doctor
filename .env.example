# Copy to .env and fill in your own keys. Never commit .env.
# Main conversation and RAG answer model: DeepSeek V4.1 Flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Downloaded local embeddings; no API key required
BGE_MODEL_PATH=models/bge-small-zh-v1.5
# Optional web search; disabled by default
ENABLE_WEB_SEARCH=false
TAVILY_API_KEY=

RUN_MODE=flask
# Default local server port. The frontend is configured to use this value.
PORT=5001
