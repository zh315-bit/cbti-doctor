"""Offline-only r8 preflight tests. No DNS, transport, HTTP, model, or cases."""
from __future__ import annotations

import contextlib
import io
import json
import tempfile
import unittest
from pathlib import Path
from unittest.mock import patch

from scripts import preflight_step9_63c_r5_mac_local as preflight


GOOD_NETWORK = {
    "SYSTEM_DNS_STATUS": "PASS", "PYTHON_GETADDRINFO_STATUS": "PASS",
    "DEFAULT_DIG_STATUS": "PASS", "GOOGLE_DNS_STATUS": "PASS",
    "CLOUDFLARE_DNS_STATUS": "PASS", "TCP_CONNECTION": "PASS",
    "TLS_CONNECTION": "PASS", "TLS_CERTIFICATE_PRESENT": True,
    "TLS_CERTIFICATE_VERIFIED": True, "TLS_VERSION": "TLSv1.3",
}
TEST_PREFLIGHT_ID = "preflight-step9_63c_r5-r8-" + "1" * 32


class R8MacLocalPreflightTests(unittest.TestCase):
    def test_dns_failure(self):
        with self.assertRaisesRegex(RuntimeError, "DNS_NOT_READY"):
            preflight.validate_transport({**GOOD_NETWORK, "DEFAULT_DIG_STATUS": "FAIL"})

    def test_tcp_failure(self):
        with self.assertRaisesRegex(RuntimeError, "TCP_CONNECTION_FAILED"):
            preflight.validate_transport({**GOOD_NETWORK, "TCP_CONNECTION": "FAIL"})

    def test_tls_failure(self):
        with self.assertRaisesRegex(RuntimeError, "TLS_CONNECTION_FAILED"):
            preflight.validate_transport({**GOOD_NETWORK, "TLS_CONNECTION": "FAIL"})

    def test_certificate_missing(self):
        with self.assertRaisesRegex(RuntimeError, "TLS_CERTIFICATE_MISSING"):
            preflight.validate_transport({**GOOD_NETWORK, "TLS_CERTIFICATE_PRESENT": False})

    def test_certificate_unverified(self):
        with self.assertRaisesRegex(RuntimeError, "TLS_CERTIFICATE_NOT_VERIFIED"):
            preflight.validate_transport({**GOOD_NETWORK, "TLS_CERTIFICATE_VERIFIED": False})

    def _config_failure(self, values, reason):
        from scripts import preflight_step9_63b_mac_local as transport
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            (root / ".env").write_text("# synthetic only\n", encoding="utf-8")
            fake_python = root / ".venv/bin/python"
            with patch.object(transport, "ROOT", root), \
                 patch.object(transport, "EXPECTED_ROOT", root), \
                 patch.object(transport, "EXPECTED_PYTHON", fake_python), \
                 patch.object(transport.sys, "platform", "darwin"), \
                 patch.object(transport.sys, "executable", str(fake_python)), \
                 patch.object(transport.sys, "prefix", str(root / ".venv")), \
                 patch.object(transport.Path, "cwd", return_value=root), \
                 patch.object(transport.importlib, "import_module"), \
                 patch.object(transport, "load_dotenv"), \
                 patch.object(transport.os, "getenv", side_effect=lambda key, default="": values.get(key, default)):
                with self.assertRaisesRegex(RuntimeError, reason):
                    transport._runtime_and_config()

    def test_missing_api_key(self):
        self._config_failure({}, "API_KEY_MISSING")

    def test_wrong_deepseek_host(self):
        self._config_failure({"DEEPSEEK_API_KEY": "synthetic", "DEEPSEEK_BASE_URL": "https://example.com"},
                             "MODEL_BASE_URL_MISMATCH")

    def test_wrong_model(self):
        self._config_failure({"DEEPSEEK_API_KEY": "synthetic", "DEEPSEEK_MODEL": "other-model"},
                             "MODEL_PROFILE_MISMATCH")

    def test_r8_aggregate_hash_mismatch(self):
        with patch.object(preflight, "R8_SHA256", "0" * 64):
            with self.assertRaisesRegex(RuntimeError, "R8_RUNNER_AGGREGATE_HASH_MISMATCH"):
                preflight.validate_freeze()

    def test_r8_member_hash_mismatch(self):
        original = preflight.sha256
        with patch.object(preflight, "sha256", side_effect=lambda path: (
                "0" * 64 if path == preflight.ROOT / "scripts/v3_execution_transaction.py"
                else original(path))):
            with self.assertRaisesRegex(RuntimeError, "R8_FREEZE_MEMBER_HASH_MISMATCH"):
                preflight.validate_freeze()

    def test_v3_agent_mismatch(self):
        with patch.object(preflight, "validate_freeze", return_value=preflight.read_json(preflight.FREEZE_PATH)), \
             patch.object(preflight, "validate_authorization", return_value=preflight.read_json(preflight.AUTH_PATH)), \
             patch.object(preflight, "validate_identity_absence"), \
             patch.object(preflight, "active_executable_ids", return_value=[preflight.AUTH_ID]), \
             patch.object(preflight.historical, "historical_pins_match", return_value=55), \
             patch.object(preflight.adapter, "validate_frozen_v3_identity",
                          return_value={"all_frozen_hashes_match": True,
                                        "treatment_agent_sha256": "wrong"}):
            with self.assertRaisesRegex(RuntimeError, "FROZEN_IDENTITY_MISMATCH"):
                preflight.execution_state()

    def test_authorization_manifest_hash_mismatch(self):
        with patch.object(preflight, "AUTH_SHA256", "0" * 64):
            with self.assertRaisesRegex(RuntimeError, "AUTHORIZATION_MANIFEST_HASH_MISMATCH"):
                preflight.validate_authorization(preflight.read_json(preflight.FREEZE_PATH))

    def test_authorization_already_consumed(self):
        freeze = preflight.read_json(preflight.FREEZE_PATH)
        original = preflight.read_json
        changed = {**original(preflight.AUTH_PATH), "consumed": True}
        with patch.object(preflight, "read_json", side_effect=lambda path: (
                changed if path == preflight.AUTH_PATH else original(path))):
            with self.assertRaisesRegex(RuntimeError, "AUTHORIZATION_BINDING_MISMATCH"):
                preflight.validate_authorization(freeze)

    def test_multiple_active_authorizations(self):
        with patch.object(preflight, "validate_freeze", return_value=preflight.read_json(preflight.FREEZE_PATH)), \
             patch.object(preflight, "validate_authorization", return_value=preflight.read_json(preflight.AUTH_PATH)), \
             patch.object(preflight, "validate_identity_absence"), \
             patch.object(preflight, "active_executable_ids", return_value=[preflight.AUTH_ID, "other"]), \
             patch.object(preflight.historical, "historical_pins_match") as history:
            with self.assertRaisesRegex(RuntimeError, "ACTIVE_AUTHORIZATION_MISMATCH"):
                preflight.execution_state()
            history.assert_not_called()

    def test_attempt_collision(self):
        with tempfile.TemporaryDirectory() as directory, patch.object(preflight, "RUN_ROOT", Path(directory)):
            (Path(directory) / f"{preflight.ATTEMPT_ID}_raw_traces.jsonl").write_text("synthetic")
            with self.assertRaisesRegex(RuntimeError, "ATTEMPT_OUTPUT_COLLISION"):
                preflight.validate_identity_absence(preflight.read_json(preflight.AUTH_PATH))

    def test_namespace_collision(self):
        with tempfile.TemporaryDirectory() as directory, patch.object(preflight, "RUN_ROOT", Path(directory)):
            (Path(directory) / preflight.NAMESPACE_ID).mkdir()
            with self.assertRaisesRegex(RuntimeError, "NAMESPACE_EXISTS"):
                preflight.validate_identity_absence(preflight.read_json(preflight.AUTH_PATH))

    def test_transaction_identity_collision_and_appledouble_sidecar(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            journal = root / "other-auth.jsonl"
            journal.write_text("synthetic", encoding="utf-8")
            (root / "._other-auth.jsonl").write_bytes(b"\xff\xfe")
            with patch.object(preflight.transaction, "TRANSACTION_ROOT", root), \
                 patch.object(preflight, "RUN_ROOT", root), \
                 patch.object(preflight.transaction, "read_events", return_value=[
                     {"authorization_id": "other-auth", "attempt_id": preflight.ATTEMPT_ID}
                 ]) as read_events:
                with self.assertRaisesRegex(RuntimeError, "TRANSACTION_IDENTITY_COLLISION"):
                    preflight.validate_identity_absence(preflight.read_json(preflight.AUTH_PATH))
                read_events.assert_called_once_with(journal)

    def test_historical_pin_mismatch(self):
        with patch.object(preflight, "validate_freeze", return_value=preflight.read_json(preflight.FREEZE_PATH)), \
             patch.object(preflight, "validate_authorization", return_value=preflight.read_json(preflight.AUTH_PATH)), \
             patch.object(preflight, "validate_identity_absence"), \
             patch.object(preflight, "active_executable_ids", return_value=[preflight.AUTH_ID]), \
             patch.object(preflight.historical, "historical_pins_match", return_value=54):
            with self.assertRaisesRegex(RuntimeError, "HISTORICAL_PIN_MISMATCH"):
                preflight.execution_state()

    def test_historical_global_root_not_current_collision(self):
        with tempfile.TemporaryDirectory() as directory, patch.object(preflight, "RUN_ROOT", Path(directory)):
            (Path(directory) / preflight.EVALUATION_ID).mkdir()
            preflight.validate_identity_absence(preflight.read_json(preflight.AUTH_PATH))

    def test_pre_post_state_change_fails_closed(self):
        from scripts import preflight_step9_63b_mac_local as transport
        with tempfile.TemporaryDirectory() as directory, \
             patch.object(preflight, "ARTIFACT_DIR", Path(directory)), \
             patch.object(transport, "_runtime_and_config", return_value={}), \
             patch.object(preflight, "execution_state", side_effect=[{"state": 1}, {"state": 2}]), \
             patch.object(transport, "connectivity", return_value=GOOD_NETWORK):
            with self.assertRaisesRegex(RuntimeError, "PRE_POST_STATE_MISMATCH"):
                preflight.run_preflight(TEST_PREFLIGHT_ID)

    def test_existing_artifact_blocks_network(self):
        from scripts import preflight_step9_63b_mac_local as transport
        with tempfile.TemporaryDirectory() as directory:
            path = Path(directory) / preflight.artifact_path(TEST_PREFLIGHT_ID).name
            path.write_text("historical")
            with patch.object(preflight, "ARTIFACT_DIR", Path(directory)), patch.object(transport, "connectivity") as network:
                with self.assertRaisesRegex(RuntimeError, "PREFLIGHT_ARTIFACT_EXISTS"):
                    preflight.run_preflight(TEST_PREFLIGHT_ID)
                network.assert_not_called()
            self.assertEqual(path.read_text(), "historical")

    def test_success_fixture_exclusively_writes_only_evidence(self):
        from scripts import preflight_step9_63b_mac_local as transport
        with tempfile.TemporaryDirectory() as directory, \
             patch.object(preflight, "ARTIFACT_DIR", Path(directory)), \
             patch.object(transport, "_runtime_and_config", return_value={"PROJECT_ROOT_MATCH": True}), \
             patch.object(preflight, "execution_state", return_value={"AUTHORIZATION_CONSUMED": False}), \
             patch.object(transport, "connectivity", return_value=GOOD_NETWORK) as network:
            result = preflight.run_preflight(TEST_PREFLIGHT_ID)
            self.assertFalse(result["HTTP_REQUEST_SENT"])
            self.assertEqual(result["FORMAL_V4_CASE_EXECUTED"], 0)
            path, digest = preflight.write_attestation(result)
            self.assertEqual(len(digest), 64)
            self.assertTrue(path.exists())
            with self.assertRaises(FileExistsError):
                preflight.write_attestation(result)
            network.assert_called_once()

    def test_failed_payload_cannot_write_evidence(self):
        with tempfile.TemporaryDirectory() as directory:
            with patch.object(preflight, "ARTIFACT_DIR", Path(directory)):
                with self.assertRaisesRegex(RuntimeError, "PREFLIGHT_NOT_PASSED"):
                    preflight.write_attestation({"STEP9_63C_R5_STATUS": "FAIL_CLOSED"})
            self.assertEqual(list(Path(directory).iterdir()), [])

    def test_accidental_http_model_agent_rag_execution_guard(self):
        source = Path(preflight.__file__).read_text(encoding="utf-8")
        for forbidden in ("requests.get(", "requests.post(", "httpx.", "/chat/completions",
                          "/api/chat", "create_chat_model(", "adapter.run(",
                          "begin_and_commit(", "reserve_namespace(", "_case_result("):
            self.assertNotIn(forbidden, source)

    def test_fail_closed_output_hides_exception(self):
        with patch.object(preflight, "run_preflight", side_effect=RuntimeError("secret-sentinel")):
            stream = io.StringIO()
            with contextlib.redirect_stdout(stream):
                self.assertEqual(preflight.main(), 1)
            self.assertNotIn("secret-sentinel", stream.getvalue())
            self.assertIn("FAIL_CLOSED", stream.getvalue())

    def test_real_identity_state_now_requires_new_runner_freeze(self):
        with self.assertRaises(RuntimeError):
            preflight.execution_state()  # Modified formal runner invalidates r8.


if __name__ == "__main__":
    unittest.main()
